rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Family trip poll — anyone with the link can read the tally and cast
    // a vote. Each vote document must be exactly { name, option } where
    // option is "a", "b", or "c". No deletes allowed.
    match /votes/{name} {
      allow read: if true;
      allow create, update: if
        request.resource.data.keys().hasOnly(['name', 'option']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 40 &&
        request.resource.data.option in ['a', 'b', 'c'];
      allow delete: if false;
    }

    // Lock down everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
